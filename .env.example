# 复制为 .env 后填写。此文件不放任何敏感信息。

# 数据与备份目录（不填则使用项目根下的 data/ 和 backups/）
# MCP_DATA_DIR=D:/AIAssistant/data
# MCP_BACKUP_DIR=D:/AIAssistant/backups
MCP_BACKUP_KEEP=20

# 写 Excel 时默认先演练、不落盘
MCP_DRY_RUN_DEFAULT=true
MCP_LOG_LEVEL=INFO

# 网页自动化（P2 使用）
# 默认有头模式，方便人工接管登录/验证码；定稿后可改 false
MCP_WEB_HEADLESS=false
# 单次查询最长等待毫秒数
MCP_WEB_TIMEOUT_MS=30000
# 一次最多返回多少行，超出标记 truncated
MCP_WEB_MAX_ROWS=500

# ===== 业务流程变量 =====
# 以下为敏感信息，只写在本地 .env 中，请勿提交到仓库
# 系统入口地址（对应 flows/*.yaml 里的 {{ env.ERP_BASE_URL }}）
# ERP_BASE_URL=https://your-erp.example.com
# 默认学管姓名（对应 flows/*.yaml 里的 {{ env.ERP_MANAGER }}）
# ERP_MANAGER=your-manager-name

# 作业完成情况查询（91 系统）：站点入口与默认学管
# TALKWEB_BASE_URL=https://your-91.example.com
# TALKWEB_MANAGER=your-manager-name
