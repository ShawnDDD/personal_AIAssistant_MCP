{
  "mcpServers": {
    "excel": {
      "command": "D:\\AIAssistant\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mcp_excel.server"],
      "cwd": "D:\\AIAssistant",
      "env": {
        "MCP_LOG_LEVEL": "INFO",
        "MCP_DRY_RUN_DEFAULT": "true"
      }
    },
    "web": {
      "command": "D:\\AIAssistant\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mcp_web.server"],
      "cwd": "D:\\AIAssistant",
      "env": {
        "MCP_LOG_LEVEL": "INFO",
        "MCP_WEB_HEADLESS": "false",
        "MCP_WEB_TIMEOUT_MS": "30000",
